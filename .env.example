# Optional settings for Task Hub. Copy this file to ".env" beside
# docker-compose.yml only if you need one of them. Task Hub runs correctly with
# no .env file at all.
#
#   cp .env.example .env
#
# There is deliberately no setting here for Task Hub's own address. It works
# that out from whatever address you open it on, so it is already correct on
# your home network, over Tailscale, through a Cloudflare tunnel and behind a
# reverse proxy, without being told which you are using.

# The port on this machine. Change it only if something else already uses 8080
# -- a QNAP NAS does, and so does anything else you may already be running.
# Then open Task Hub on the new number, e.g. http://192.168.1.50:9090
#TASKHUB_HTTP_PORT=8080

# Your timezone, used until the setup wizard asks you for one. After that the
# wizard's answer is what counts, so this rarely matters.
#TZ=Europe/London

# How much to believe a reverse proxy that says the request came from somewhere
# else. Leave unset unless Task Hub tells you to change it.
#
#   auto    (default) believe a proxy on this machine or your local network
#   always  for a proxy that reaches Task Hub over a public address
#   never   ignore proxy headers entirely
#TASKHUB_TRUST_PROXY=auto
